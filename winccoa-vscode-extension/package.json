{
  "name": "winccoa-oa-lsp-client",
  "displayName": "WinCC OA Data Model LSP",
  "description": "VS Code extension providing IntelliSense for WinCC OA data points, control navigation system (CNS), and configuration attributes. Includes autocomplete, hover information, and syntax support for WinCC OA projects.",
  "version": "0.0.1",
  "publisher": "etm",
  "author": "ETM professional control",
  "license": "MIT",
  "homepage": "https://github.com/winccoa/winccoa-vscode-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/winccoa/winccoa-vscode-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/winccoa/winccoa-vscode-plugin/issues"
  },
  "keywords": [
    "WinCC OA",
    "SCADA",
    "IntelliSense",
    "Language Server",
    "Autocomplete",
    "Data Points",
    "CNS"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "icon": "../icon.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onCommand:winccoaLsp.reloadIndex",
    "onLanguage:ctl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "winccoaLsp.reloadIndex",
        "title": "WinCC OA LSP: Reload Index"
      }
    ],
    "configuration": {
      "configurationDefaults": {
        "[javascript][typescript]": {
          "editor.wordWrap": "on",
          "editor.quickSuggestions": {
            "strings": "on"
          }
        }
      },
      "type": "object",
      "title": "WinCC OA LSP",
      "properties": {
        "winccoaLsp.apiUrl": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Base URL of the API used by this extension."
        },
        "winccoaLsp.port": {
          "type": "integer",
          "default": 2087,
          "description": "Port"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "socket.io": "^4.8.1",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5.4.0",
    "@types/winccoa-manager": "C:/Program Files/Siemens/WinCC_OA/3.21/javascript/@types/winccoa-manager",
    "vscode": "^1.1.34"
  }
}
