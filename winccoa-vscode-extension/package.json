{
  "name": "winccoa-oa-lsp-client",
  "displayName": "WinCC OA Data Model LSP",
  "description": "VS Code extension providing IntelliSense for WinCC OA data points, common name service (CNS), and configuration attributes. Includes autocomplete, hover information, and syntax support for WinCC OA projects.",
  "version": "0.0.1",
  "publisher": "etm",
  "author": "ETM professional control",
  "license": "MIT",
  "homepage": "https://github.com/winccoa/winccoa-vscode-plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/winccoa/winccoa-vscode-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/winccoa/winccoa-vscode-plugin/issues"
  },
  "keywords": [
    "WinCC OA",
    "SCADA",
    "IntelliSense",
    "Language Server",
    "Autocomplete",
    "Data Points",
    "CNS"
  ],
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onCommand:winccoaLsp.reloadIndex",
    "onLanguage:ctl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "winccoaLsp.reloadIndex",
        "title": "WinCC OA LSP: Reload Index"
      }
    ],
    "configurationDefaults": {
      "[javascript]": {
        "editor.quickSuggestions": {
          "other": false,
          "comments": false,
          "strings": true
        }
      },
      "[typescript]": {
        "editor.quickSuggestions": {
          "other": false,
          "comments": false,
          "strings": true
        }
      }
    },
    "configuration": {
      "type": "object",
      "title": "WinCC OA LSP",
      "properties": {
        "winccoaLsp.apiUrl": {
          "type": "string",
          "default": "127.0.0.1",
          "description": "Base URL of the API used by this extension."
        },
        "winccoaLsp.port": {
          "type": "integer",
          "default": 2087,
          "description": "Port"
        },
        "winccoaLsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --baseContentUrl '' --baseImagesUrl '' -o winccoa-oa-lsp-starter.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.98.0",
    "@types/node": "16.18.98",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "typescript": "^4.9.4",
    "@vscode/vsce": "^2.32.0"
  },
  "dependencies": {
    "socket.io": "^4.8.1",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11",
    "vscode-languageclient": "^9.0.1"
  }
}
